# .env.example — copy to .env and fill in values
# Never commit .env to version control

# ── Jira Simulator ─────────────────────────────────────────────────────────
# Base URL that SOC Memory uses to call the Jira Simulator REST API
JIRA_SIMULATOR_URL=http://localhost:5001

# Port the Jira Simulator Flask app listens on
JIRA_SIMULATOR_PORT=5001

# Secret key for Flask sessions in the Jira Simulator (change in production)
JIRA_SECRET_KEY=jira-simulator-dev-secret

# ── SOC Memory ─────────────────────────────────────────────────────────────
# Port the SOC Memory Flask app listens on
SOC_MEMORY_PORT=5000

# Secret key for Flask sessions in SOC Memory (change in production)
SOC_MEMORY_SECRET_KEY=soc-memory-dev-secret
